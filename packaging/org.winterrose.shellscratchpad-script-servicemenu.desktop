[Desktop Entry]
Type=Service
Name=Shell Scratchpad Script
Comment=Open the selected Bash script in Shell Scratchpad
MimeType=text/x-shellscript;application/x-shellscript;
Actions=openShellScript;
Icon=shell-scratchpad

[Desktop Action openShellScript]
Name=Open in Shell Scratchpad
Icon=shell-scratchpad
Exec=shell-scratchpad %f
