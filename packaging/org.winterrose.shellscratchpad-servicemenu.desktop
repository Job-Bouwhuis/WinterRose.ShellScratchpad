[Desktop Entry]
Type=Service
Name=Shell Scratchpad
Comment=Open Shell Scratchpad in the selected directory
MimeType=inode/directory;
Actions=openShellScratchpad;initGitRepository;cloneGitRepository;
Icon=shell-scratchpad

[Desktop Action openShellScratchpad]
Name=Open Shell Scratchpad
Icon=shell-scratchpad
Exec=shell-scratchpad --working-directory %f

[Desktop Action cloneGitRepository]
Name=Clone Git Repository Here…
Icon=folder-download
Exec=shell-scratchpad --clone-repository-into %f

[Desktop Action initGitRepository]
Name=Create Git Repository Here…
Icon=git-init
Exec=shell-scratchpad --init-repository-in %f
