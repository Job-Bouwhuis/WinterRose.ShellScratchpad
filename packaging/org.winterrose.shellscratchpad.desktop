[Desktop Entry]
Type=Application
Name=Shell Scratchpad
GenericName=Bash Script Scratchpad
Comment=Run Bash scripts with interactive input and save executable scripts
Exec=shell-scratchpad %f
Icon=shell-scratchpad
Terminal=false
Categories=Development;Utility;
Keywords=bash;shell;script;terminal;scratchpad;
MimeType=text/x-shellscript;application/x-shellscript;
