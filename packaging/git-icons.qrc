  <qresource prefix="/git/icons">
    <file alias="branch.svg">git-icons/branch.svg</file>
    <file alias="commit.svg">git-icons/commit.svg</file>
    <file alias="sync.svg">git-icons/sync.svg</file>
    <file alias="refresh.svg">git-icons/refresh.svg</file>
    <file alias="more.svg">git-icons/more.svg</file>
  </qresource>
</RCC>
